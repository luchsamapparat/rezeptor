{
  "name": "rezeptor",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "build": "react-router build",
    "db:generate": "dotenv -- prisma generate",
    "db:dev": "dotenv -- prisma migrate dev",
    "dev": "dotenv -- react-router dev --port 3000",
    "start": "dotenv -v NODE_ENV=production -- node dist/server/index.js",
    "lint": "eslint",
    "test": "vitest --run",
    "test:watch": "vitest --watch",
    "typecheck": "react-router typegen && tsc -b"
  },
  "dependencies": {
    "@azure/ai-form-recognizer": "5.1.0",
    "@googleapis/books": "13.0.1",
    "@hono/otel": "1.3.0",
    "@hono/zod-openapi": "1.6.3",
    "@hono/zod-validator": "0.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.83.1",
    "@opentelemetry/semantic-conventions": "1.45.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "@react-router/node": "8.5.2",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/react-query": "5.108.2",
    "@types/lodash-es": "4.17.12",
    "capitalize": "2.0.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv-cli": "11.1.0",
    "fast-xml-parser": "5.12.1",
    "hono": "4.13.19",
    "hono-pino": "0.10.3",
    "hono-simple-di": "0.2.1",
    "isbot": "5.2.3",
    "lodash-es": "4.18.1",
    "lucide-react": "1.77.0",
    "openai": "7.62.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "prisma": "7.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.2",
    "react-router-hono-server": "4.1.13",
    "serialize-error": "13.1.0",
    "sharp": "0.35.5",
    "stopword": "3.1.5",
    "swiper": "14.4.0",
    "tailwind-merge": "3.7.1",
    "tailwindcss": "4.3.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.17",
    "@eslint/js": "10.0.1",
    "@faker-js/faker": "10.6.0",
    "@react-router/dev": "8.5.2",
    "@stylistic/eslint-plugin": "6.0.1",
    "@types/capitalize": "2.0.2",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/stopword": "2.0.3",
    "@vitest/ui": "5.1.1",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "fishery": "2.4.0",
    "globals": "17.14.0",
    "mime": "4.1.2",
    "pglite-prisma-adapter": "0.7.2",
    "shadcn": "4.23.0",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "allowScripts": {
    "prisma": true,
    "@prisma/client": true,
    "@prisma/engines": true,
    "sharp": true,
    "msw": true,
    "esbuild": true
  }
}
